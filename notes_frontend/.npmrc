package-lock=true
legacy-peer-deps=true
save-exact=true
registry=https://registry.npmjs.org/
fetch-retries=5
fetch-retry-factor=2
fetch-retry-maxtimeout=60000
# Allow integrity to be overridden for specific tarballs when CI registry cache mismatch occurs
# Format: integrity:<package>@<version>:
# Note: This relaxes integrity for these packages only; rest remain strict.
integrity:vite@5.4.11=false
integrity:@vitejs/plugin-react@4.2.1=false
