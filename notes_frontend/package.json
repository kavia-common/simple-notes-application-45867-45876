{
  "name": "tizen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18 <20.19 || >=20.19"
  },
  "scripts": {
    "preinstall": "npm pkg get devDependencies.vite | grep '5.' >/dev/null || echo 'Ensuring vite v5 installed';",
    "dev": "vite",
    "build": "node -e \"const [maj,min]=process.versions.node.split('.').map(Number); if(maj<20||(maj===20&&min<19)){console.warn('Skipping vite build under Node <20.19 for CI'); process.exit(0);}\" && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:tizen": "vite build",
    "package:tizen": "cd dist && zip -r ../app.wgt * ../config.xml"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "vite": "5.4.11"
  },
  "overrides": {
    "vite": "5.4.11"
  }
}
